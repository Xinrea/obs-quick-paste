{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install"
      }
    },
    {
      "name": "tests",
      "displayName": "Qt-only tests (no OBS SDK)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_PLUGIN": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "BUILD_PLUGIN": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "BUILD_PLUGIN": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "tests", "configurePreset": "tests" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
