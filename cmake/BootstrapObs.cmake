# Explicit opt-in SDK bootstrap, based on obs-plugintemplate's Development
# component build. Normal project configuration never downloads dependencies.
cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED DEPS_DIR)
  get_filename_component(DEPS_DIR "${CMAKE_CURRENT_LIST_DIR}/../.deps" ABSOLUTE)
endif()
set(_version 32.0.4)
set(_sha256 625ee6a29c3cf93177436094b8a16254c3eb21162356662b9a62c122aabd0a4b)
set(_source "${DEPS_DIR}/obs-studio-${_version}")
set(_build "${DEPS_DIR}/obs-build")
set(_sdk "${DEPS_DIR}/obs-sdk")
file(MAKE_DIRECTORY "${DEPS_DIR}/downloads")

if(NOT EXISTS "${_source}/CMakeLists.txt")
  set(_archive "${DEPS_DIR}/downloads/obs-studio-${_version}.tar.gz")
  file(DOWNLOAD
    "https://codeload.github.com/obsproject/obs-studio/tar.gz/refs/tags/${_version}"
    "${_archive}" EXPECTED_HASH "SHA256=${_sha256}" TLS_VERIFY ON
    SHOW_PROGRESS)
  file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${DEPS_DIR}")
endif()

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  if(NOT DEFINED OBS_ARCH)
    set(OBS_ARCH arm64)
  endif()
  set(_generator -G Xcode "-DCMAKE_OSX_ARCHITECTURES=${OBS_ARCH}"
    -DCMAKE_OSX_DEPLOYMENT_TARGET=12.0
    "-DCMAKE_PROJECT_obs-studio_INCLUDE=${CMAKE_CURRENT_LIST_DIR}/EnableObsSwift.cmake")
  set(_deps_platform universal)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
  set(_generator -G "Visual Studio 17 2022" -A x64)
  set(_deps_platform x64)
else()
  message(FATAL_ERROR "Bootstrap supports macOS and Windows. Linux tests need only Qt 6.")
endif()

# OBS's pinned buildspec.json fetches and hash-verifies its own official
# obs-deps and Qt SDK. Browser/CEF and scripting are unnecessary for this SDK.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_source}" -B "${_build}"
  ${_generator}
  -DENABLE_FRONTEND=OFF -DENABLE_PLUGINS=OFF -DENABLE_BROWSER=OFF
  -DENABLE_SCRIPTING=OFF "-DOBS_VERSION_OVERRIDE=${_version}"
  COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_build}"
  --target obs-frontend-api --config Release --parallel
  COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${_build}"
  --component Development --config Release --prefix "${_sdk}"
  COMMAND_ERROR_IS_FATAL ANY)

file(READ "${_source}/buildspec.json" _spec)
string(JSON _deps_version GET "${_spec}" dependencies prebuilt version)
string(JSON _qt_version GET "${_spec}" dependencies qt6 version)
set(_prefixes "${_sdk};${_source}/.deps/obs-deps-${_deps_version}-${_deps_platform};${_source}/.deps/obs-deps-qt6-${_qt_version}-${_deps_platform}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  list(PREPEND _prefixes "${_sdk}/Frameworks")
endif()
file(WRITE "${DEPS_DIR}/sdk-prefix.cmake"
  "# Generated by BootstrapObs.cmake; do not commit machine-specific paths.\n"
  "set(CMAKE_PREFIX_PATH \"${_prefixes}\" CACHE STRING \"OBS and Qt SDKs\")\n")
message(STATUS "SDK ready. Configure with -C \"${DEPS_DIR}/sdk-prefix.cmake\"")
